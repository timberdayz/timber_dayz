# 安全配置文件 - 绝对不上传
local_accounts.py
local_accounts.json
local_accounts.yaml
real_accounts.*
production_accounts.*
auth.json
*.local
*.private
secure_accounts.enc
secure_account_key.key

# 会话和OTP文件 - 包含敏感信息
data/sessions/
data/session_profiles/
data/device_fingerprints/
temp/outputs/otp_emails/

