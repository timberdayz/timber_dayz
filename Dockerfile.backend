# 西虹ERP系统 - 后端生产环境Dockerfile

FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    postgresql-client \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件（锁文件 = 生产运行时依赖的单一真相源）
COPY requirements.lock.txt requirements.lock.txt

# 安装Python依赖（单步安装，版本全部锁死）
# [FIX v7.12.9] 旧版分两步安装（backend/requirements.txt + 根 requirements.txt），
# 两份清单有 26 个包互相矛盾且第二步会覆盖第一步；更严重的是 celery 的传递依赖
# kombu 没被任何文件钉住，两次构建之间从 5.6.2 漂到 5.7.0，而 kombu 5.7.0 硬性
# 要求 redis-py>=6.1.0，与钉死的 redis==5.0.1 冲突 ->
# celery-worker 上线即抛 kombu.exceptions.VersionMismatch 崩溃循环（v7.12.7 事故）。
# 现在只装 requirements.lock.txt：全部传递依赖版本锁死，不再有任何浮动解析。
# gunicorn / uvicorn[standard] 已在 lock 文件内，不再单独安装。
RUN pip install --upgrade pip && \
    pip install -r requirements.lock.txt

# 复制应用代码
COPY backend /app/backend
COPY modules /app/modules
COPY tools /app/tools
COPY config /app/config
COPY current_migrations /app/current_migrations
COPY alembic-current.ini /app/alembic-current.ini
COPY VERSION /app/VERSION

# [OPS] 运维脚本：生产环境常用脚本（如创建管理员、Bootstrap、Metabase 初始化）
# 注意：scripts/ 目录内容较多，避免整体 COPY 导致镜像膨胀，按需复制关键脚本
RUN mkdir -p /app/scripts /app/sql
COPY scripts/create_admin_user.py /app/scripts/create_admin_user.py
COPY scripts/bootstrap_production.py /app/scripts/bootstrap_production.py
COPY scripts/bootstrap_postgresql_dashboard.py /app/scripts/bootstrap_postgresql_dashboard.py
COPY scripts/check_postgresql_dashboard_ops.py /app/scripts/check_postgresql_dashboard_ops.py
COPY scripts/migrate_cloud_sync_tables.py /app/scripts/migrate_cloud_sync_tables.py
COPY scripts/rebuild_inventory_age_from_snapshots.py /app/scripts/rebuild_inventory_age_from_snapshots.py
COPY scripts/rebuild_inventory_state_from_snapshots.py /app/scripts/rebuild_inventory_state_from_snapshots.py
COPY scripts/rebuild_views.py /app/scripts/rebuild_views.py
COPY scripts/smoke_postgresql_dashboard_routes.py /app/scripts/smoke_postgresql_dashboard_routes.py
COPY scripts/verify_system_role_integrity.py /app/scripts/verify_system_role_integrity.py
COPY scripts/verify_schema_consistency.py /app/scripts/verify_schema_consistency.py
COPY scripts/sync_schema_columns.py /app/scripts/sync_schema_columns.py
COPY scripts/run_current_schema_migrations.py /app/scripts/run_current_schema_migrations.py
COPY scripts/local_migration_backup.py /app/scripts/local_migration_backup.py
# 空库引导（scripts/bootstrap_fresh_environment.py）依赖的清单模块 ——
# run_current_schema_migrations.py 在 import 时就要用到它，缺了镜像里的迁移器会直接崩。
COPY scripts/bootstrap_seed_manifest.py /app/scripts/bootstrap_seed_manifest.py
COPY scripts/bootstrap_fresh_environment.py /app/scripts/bootstrap_fresh_environment.py
COPY scripts/migrate_profit_basis_to_v2.py /app/scripts/migrate_profit_basis_to_v2.py
# [OPS] 模板治理 v2（2026-11-14，批次 3/4）：模板**决策资产**进 Git
#
#   templates/definitions/*.json —— 「这个维度该长什么样」的声明式定义；
#   scripts/template_definitions.py —— 定义格式的 SSOT（字段清单 / 目录解析）；
#   scripts/apply_template_definitions.py —— 差异守卫与投影工具（--check / --apply）；
#   scripts/export_template_definitions.py —— 从库里反向导出（单向）；
#   scripts/replay_drift_caliber.py —— 只读回放两套漂移口径；
#   scripts/template_release_sla_metric.py —— 「发布后多久完成重估」闭环指标。
#
#   [*] 为什么要显式写这一段：本文件对 scripts/ 采用**白名单式 COPY**
#       （逐个 COPY，避免整体复制导致镜像膨胀）。
#       ⇒ 新加的运维脚本如果忘了在这里登记，**生产镜像里根本没有这个文件**：
#       业务代码不受影响，部署也照样成功，但守卫**静默失效**——
#       线上以为「决策资产守卫已经上线」，其实连脚本都没进镜像。
#       2026-11-14 v7.29.0 上线时就是这样漏掉的（templates/ 与 5 个新脚本全缺）。
#       ⇒ 守护见 backend/tests/data_pipeline/test_template_definitions_guardrails.py
#         ::test_backend_image_ships_template_decision_assets
COPY templates /app/templates
COPY scripts/template_definitions.py /app/scripts/template_definitions.py
COPY scripts/apply_template_definitions.py /app/scripts/apply_template_definitions.py
COPY scripts/export_template_definitions.py /app/scripts/export_template_definitions.py
COPY scripts/replay_drift_caliber.py /app/scripts/replay_drift_caliber.py
COPY scripts/template_release_sla_metric.py /app/scripts/template_release_sla_metric.py
# [OPS] 库存快照 data_hash 重建（2026-11-14）
#
#   scripts/rebuild_inventory_snapshot_hash.py —— 按「当前口径」重算
#   b_class.fact_miaoshou_inventory_snapshot 的 data_hash（data_hash 是行身份，
#   口径一变就必须同口径重建），并把塌成同一身份键的重复行合并掉。
#   默认只读；--apply 才写库，写库前先备份。
COPY scripts/rebuild_inventory_snapshot_hash.py /app/scripts/rebuild_inventory_snapshot_hash.py
COPY sql/api_modules /app/sql/api_modules
COPY sql/mart /app/sql/mart
COPY sql/ops /app/sql/ops
COPY sql/semantic /app/sql/semantic
COPY sql/metabase_models /app/sql/metabase_models
COPY sql/metabase_questions /app/sql/metabase_questions

# [OPS] 入口脚本：启动前自动执行数据库迁移
COPY docker/scripts/backend-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# 创建必要的目录
RUN mkdir -p /app/data /app/logs /app/temp /app/uploads

# 设置权限
RUN chmod -R 755 /app

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动前执行迁移，再执行 CMD
ENTRYPOINT ["/app/entrypoint.sh"]

# 启动命令（生产环境使用Gunicorn）
CMD ["gunicorn", "backend.main:app", \
     "--workers", "4", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--keep-alive", "5", \
     "--access-logfile", "/app/logs/access.log", \
     "--error-logfile", "-", \
     "--log-level", "info"]
